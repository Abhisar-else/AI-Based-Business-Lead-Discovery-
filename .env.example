# =============================================
# AI Business Lead Discovery — Environment Variables
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# --- AI Provider (choose one) ---
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here   # Optional fallback

# --- Google Maps Data Source ---
# Get a free key at: https://serpapi.com (100 free searches/month)
SERPAPI_KEY=your-serpapi-key-here

# --- Google Sheets ---
# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your-google-spreadsheet-id-here

# --- Google Sheets Worksheet Name ---
SHEET_NAME=Business Leads

# --- Optional: Path to GCP Service Account JSON ---
GOOGLE_CREDENTIALS_PATH=credentials/google_credentials.json
